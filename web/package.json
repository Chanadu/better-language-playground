{
  "name": "better-language-playground",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && npm run build:static && npm run build:js && npm run build:css && npm run build:wasm",
    "build:static": "node ./scripts/copy-static.mjs",
    "build:js": "node ./node_modules/typescript/bin/tsc",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/styles.css -o ./dist/output.css",
    "build:wasm": "cd ../Better-Language && GOOS=js GOARCH=wasm go build -o ../web/dist/main.wasm .",
    "dev": "node ./dev-server.mjs",
    "test": "npm run build"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/golang-wasm-exec": "^1.15.2"
  }
}
